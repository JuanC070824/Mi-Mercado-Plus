# Copiar a .env en la raíz. Nunca subir el archivo .env.
DJANGO_SECRET_KEY=aca_lo_generas_en_tu_misma_pc
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=26977
DB_HOST=pg-mi-mercado-plus-1-mi-mercado-plus.c.aivencloud.com
DB_PORT=26977
DB_SSLMODE=require
# Para validar el certificado del servidor: DB_SSLMODE=verify-full y ruta del CA de Aiven.
# DB_SSLROOTCERT=C:/ruta/ca.pem
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_TOKEN_TTL_SECONDS=3600
# mock: simulación local explícita. culqi_sandbox: llamadas a Culqi con claves test.
# disabled: pago no habilitado. No usar claves live.
PAYMENT_MODE=mock
MOCK_YAPE_CODE=123456
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
