# Copiar a .env en la raíz. Nunca subir el archivo .env.
DJANGO_SECRET_KEY=aca_lo_generas_en_tu_misma_pc
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=defaultdb
DB_USER=USUARIO_DE_AIVEN
DB_PASSWORD=PASSWORD_AIVEN
DB_HOST=HOST_AIVEN
DB_PORT=PORT_AIVEN
DB_SSLMODE=require
CORS_ALLOWED_ORIGINS=http://localhost:3000

AUTH_TOKEN_TTL_SECONDS=3600
JSONPE_KEY=TOKEN_DE_JSON_PE
JSONPE_DNI_URL=https://api.json.pe/api/dni
JSONPE_TIMEOUT_SECONDS=10
JSONPE_REGISTRATION_TOKEN_TTL_SECONDS=600
# mock: demostración local, sin conexiones externas ni dinero real.
# disabled: pago no habilitado. No se requieren llaves de pasarela.
PAYMENT_MODE=mock
MOCK_YAPE_CODE=123456

